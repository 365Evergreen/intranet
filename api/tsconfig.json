{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["es2022"],
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "vitest.config.ts"]
}
