{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "description": "Azure Functions backend for the Evergreen intranet",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.31.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "18.x",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.2.1"
  }
}
